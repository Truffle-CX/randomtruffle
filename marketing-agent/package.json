{
  "name": "marketing-health-check-agent",
  "version": "1.0.0",
  "description": "Agente de marketing especializado con Gemini ADK para health checks de GA4, Google Ads y Meta",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:google-chat": "node dist/integrations/google-chat.js",
    "start:telegram": "node dist/integrations/telegram.js",
    "start:whatsapp": "node dist/integrations/whatsapp.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "gemini",
    "adk",
    "marketing",
    "ga4",
    "google-ads",
    "meta",
    "health-check",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0",
    "google-auth-library": "^9.17.0",
    "googleapis": "^144.0.0",
    "whatsapp-web.js": "^1.26.0",
    "qrcode-terminal": "^0.12.0",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
