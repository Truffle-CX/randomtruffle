# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# MCP Server Configuration
MCP_GA4_SERVER_PATH=./mcp-servers/ga4/dist/index.js
MCP_GOOGLE_ADS_SERVER_PATH=./mcp-servers/google-ads/dist/index.js

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
GA4_CREDENTIALS_PATH=./credentials/ga4-credentials.json

# Google Ads
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id

# Meta Business
META_ACCESS_TOKEN=your_meta_access_token
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_AD_ACCOUNT_ID=act_your_account_id

# Google Chat Integration
GOOGLE_CHAT_PROJECT_ID=your_project_id
GOOGLE_CHAT_CREDENTIALS_PATH=./credentials/google-chat-credentials.json
GOOGLE_CHAT_PORT=8080

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp Integration
WHATSAPP_SESSION_PATH=./whatsapp-session

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/agent.log

# Server Configuration
PORT=3000
NODE_ENV=production
